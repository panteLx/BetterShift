# Settings for scripts/create-posthog-dashboard.mjs — copy to .env (gitignored), then `npm run dashboard`.
# Not the Worker's config: that lives in wrangler.toml and .dev.vars.

# Personal key (phx_...) with the dashboard:write, insight:write and project:read scopes.
POSTHOG_PERSONAL_API_KEY=

# Optional. Only needed if the key can see more than one project.
# POSTHOG_PROJECT_ID=

# Optional. App host, not the eu.i.posthog.com ingest host.
# POSTHOG_HOST=https://eu.posthog.com

# Optional. Instance ids to leave out of the "ohne Test-Instanzen" dashboard (comma-separated).
# EXCLUDE_INSTANCE_IDS=

# Optional. DASHBOARD_NAME, and DASHBOARD_VARIANTS=all,no-dev,dev-only,no-ids
