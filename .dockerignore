# dependencies
# **/ because Docker matches the whole relative path: a bare "node_modules"
# excludes the root one only.
**/node_modules
.pnp
.pnp.*

# testing
coverage

# next.js
**/.next/
out/
build

# production
dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (excluded for security - use build args or runtime env)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database (local data should not be in image)
sqlite.db
sqlite.db-journal
sqlite.db-shm
sqlite.db-wal
data/

# git
.git
.gitignore
.github

# Agent worktrees: gitignored, so CI never sends them -- a local build does.
.claude
.LOCAL

# IDE
.vscode
.idea

# docker
docker-compose.override.yml

# misc
*.md
LICENSE
